# ─────────────────────────────────────────
# AI Todo — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values
#    cp .env.example .env
# Never commit .env to git
# ─────────────────────────────────────────


# ── App ──────────────────────────────────
# Environment: development | production
APP_ENV=development

# Port the FastAPI server runs on
APP_PORT=8000

# Secret key for signing JWT tokens
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_long_random_secret_key_here


# ── PostgreSQL ────────────────────────────
POSTGRES_USER=aitodo_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=aitodo_db

# Assembled from the values above — change only if you rename the service
DATABASE_URL=postgresql+asyncpg://aitodo_user:your_postgres_password_here@postgres:5432/aitodo_db


# ── Neo4j ─────────────────────────────────
# Default Neo4j bolt port is 7687
# Service name in docker-compose is "neo4j"
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here


# ── ChromaDB ──────────────────────────────
# Service name in docker-compose is "chroma"
CHROMA_HOST=chroma
CHROMA_PORT=8001


# ── Redis ─────────────────────────────────
# Service name in docker-compose is "redis"
REDIS_URL=redis://redis:6379/0


# ── Anthropic (Claude) ────────────────────
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── Google OAuth ──────────────────────────
# Create credentials at: https://console.cloud.google.com
# Application type: Web application
# You will need Gmail API and Google Calendar API enabled
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# This must match exactly what you set in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback